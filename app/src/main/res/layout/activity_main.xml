<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:paddingTop="48dp"
    android:gravity="center"
    android:background="@drawable/login_gradient_background"
    android:fitsSystemWindows="false">

    <!-- Logo Section -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="48dp">

        <!-- Logo Icon (Orange bars) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">

            <View
                android:layout_width="48dp"
                android:layout_height="8dp"
                android:background="@drawable/orange_rounded_bar"
                android:layout_marginBottom="6dp" />

            <View
                android:layout_width="48dp"
                android:layout_height="8dp"
                android:background="@drawable/orange_rounded_bar" />
        </LinearLayout>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIBRIUM"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FF5722"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="8" />

    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your AI-First Wellness Assistant"
        android:textSize="16sp"
        android:textColor="#94A3B8"
        android:gravity="center"
        android:layout_marginBottom="48dp" />

    <!-- Login Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:layout_marginHorizontal="8dp">

        <!-- Email Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_field_background"
            android:padding="4dp"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Email address"
                android:inputType="textEmailAddress"
                android:padding="16dp"
                android:background="@android:color/transparent"
                android:textColor="#E2E8F0"
                android:textColorHint="#64748B"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Password Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_field_background"
            android:padding="4dp"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/passwordEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="16dp"
                android:background="@android:color/transparent"
                android:textColor="#E2E8F0"
                android:textColorHint="#64748B"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Sign In Button -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🚀 Sign In"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/primary_button_background"
            android:layout_marginBottom="20dp"
            android:elevation="4dp" />

        <!-- Divider with text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginVertical="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#334155" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  or  "
                android:textColor="#64748B"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#334155" />

        </LinearLayout>

        <!-- Quick Access Options -->
        <Button
            android:id="@+id/quickTestButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🧪 Quick Test Access"
            android:textSize="14sp"
            android:textColor="#FF5722"
            android:background="@drawable/secondary_button_background"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/googleSignInButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📱 Sign in with Google"
            android:textSize="14sp"
            android:textColor="#E2E8F0"
            android:background="@drawable/secondary_button_background" />

    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Powered by Gemini AI"
        android:textSize="12sp"
        android:textColor="#64748B"
        android:layout_marginTop="32dp" />

</LinearLayout>